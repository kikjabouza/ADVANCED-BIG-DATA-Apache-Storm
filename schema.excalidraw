      "text": "La régression est une technique de Machine Learning qui consiste à prédire une\nvaleur numérique continue à partir d'une ou plusieurs variables explicatives.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La régression est une technique de Machine Learning qui consiste à prédire une valeur numérique continue à partir d'une ou plusieurs variables explicatives.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
